<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override. Debug builds allow cleartext HTTP to any host so the
  Developer settings "Server URL" field can point at a LAN dev server
  (e.g. http://192.168.1.10:3000). Release builds keep the restrictive
  main-source-set config and should use HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
