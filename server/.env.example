# ── MuSync Server Environment Variables ──────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# Network interface to bind to (default: 0.0.0.0 = all interfaces).
# The default lets phones on the same Wi-Fi reach the server at
# http://<your-computer-lan-ip>:3000 — the startup log prints the exact URL.
# Set to 127.0.0.1 to accept connections from this machine only.
HOST=0.0.0.0

# YouTube Data API v3 key. Required for /api/youtube/search and
# /api/youtube/video-info. Without it both endpoints return HTTP 503 and
# the Android app's search & in-room playback will not work.
# See docs/youtube-api-key.md for how to generate and restrict a key.
YOUTUBE_API_KEY=

# YouTube proxy tuning
YOUTUBE_SEARCH_TIMEOUT_MS=8000
YOUTUBE_VIDEO_INFO_TIMEOUT_MS=8000
YOUTUBE_VIDEO_INFO_CACHE_SIZE=500

# ── YouTube response cache (quota protection) ─────────────────────────────────
# The YouTube Data API v3 free quota is 10,000 units/day and a single search
# costs 100 units — only ~100 searches/day for the whole server. Search results
# are therefore cached in Upstash Redis (see the section below; the same
# credentials are used for room state) under a normalized-query key.
#
# TTL for cached search results (default: 86400 = 24 hours). Video metadata is
# cached for 7 days under a separate namespace.
YOUTUBE_CACHE_TTL_SECONDS=86400

# Daily quota used for the /metrics/youtube counters and the 80% warning log
# (default: 10000 — raise it only if Google granted you a higher quota).
YOUTUBE_DAILY_QUOTA_UNITS=10000

# ── Upstash Redis (Session State) ─────────────────────────────────────────────
# Obtain these values from your Upstash console: https://console.upstash.com
# When both variables are set the server persists room state in Redis with a
# 4-hour TTL and caches YouTube API responses.  If either variable is absent
# the server falls back to an in-memory room store and the YouTube cache
# becomes a no-op pass-through (suitable for local development and testing).

UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-rest-token>

# ── Android App Links (Invite-link domain) ────────────────────────────────────
# Serving the invite-link domain (`https://<host>/room/<id>`) from the same
# host as the Socket.IO API requires the server to expose an Android App
# Links manifest at `/.well-known/assetlinks.json`.  Set both variables below
# to enable that route; leave them unset to disable it (the route returns 404).
#
# ANDROID_APP_PACKAGE_NAME      Application id of the Android app
#                               (matches `applicationId` in android/build.gradle.kts)
# ANDROID_APP_SHA256_FINGERPRINTS
#                               Comma-separated SHA-256 signing-certificate
#                               fingerprints (uppercase hex, colon-separated).
#                               Include both your debug and release fingerprints
#                               if you want App Links to verify for both builds.
#                               Get them with:
#                                 keytool -list -v -keystore <keystore> -alias <alias>

ANDROID_APP_PACKAGE_NAME=com.musync
ANDROID_APP_SHA256_FINGERPRINTS=AA:BB:CC:...,11:22:33:...
# ^^^ For CI-built debug APKs use the SHA-256 fingerprint from the keystore
#     configured via DEBUG_KEYSTORE_BASE64 / DEBUG_KEY_* secrets in GitHub Actions.
#     Release signing is separate; add its fingerprint here alongside the debug one
#     when both build types need App Links verification.
#     Retrieve the fingerprint with:
#       keytool -list -v -keystore debug.jks -alias <alias>
